# VAGA — staging environment (plain PHP + MySQL host, no Redis/Meilisearch/Docker).
# Copy to `.env` ON THE SERVER (never commit the real one) and fill the blanks.

APP_NAME=VAGA
APP_ENV=staging
APP_KEY=                       # generate once: `php artisan key:generate --show`
APP_DEBUG=false
APP_URL=https://staging.vagacultural.pt

APP_LOCALE=pt
APP_FALLBACK_LOCALE=pt

LOG_CHANNEL=stack
LOG_LEVEL=warning

# --- Database (use the host's MySQL credentials) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# --- No external services on staging: everything runs on MySQL / the filesystem ---
SESSION_DRIVER=database
QUEUE_CONNECTION=sync          # no queue worker on shared hosting → run jobs inline
CACHE_STORE=database
FILESYSTEM_DISK=public

# Search without Meilisearch: the collection engine filters in PHP (fine at this scale)
SCOUT_DRIVER=collection

# Staging shouldn't send real email
MAIL_MAILER=log
