includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    paths:
        - app
        - database
        - routes
    tmpDir: storage/framework/phpstan
    # checkModelProperties left off: it requires every create()/update() array key to be a
    # statically-known column, which conflicts with dynamic mass-assignment from validated
    # FormRequests. Model property *types* are still enforced via @property docblocks.
    checkModelProperties: false
    checkOctaneCompatibility: false
